# Copy to deploy/.env and fill in. Never commit .env.
DOMAIN=ncr.jemco.example
ACME_EMAIL=it@jemco.example
TZ=Asia/Kuala_Lumpur

DB_USER=jemco
DB_PASSWORD=change-me-to-a-long-random-string
DB_NAME=jemco
BACKUP_KEEP_DAYS=35

# Images: leave as is to pull from GHCR, or run `docker compose build` to build locally.
API_IMAGE=ghcr.io/adpediagitofficial/jemco-api:latest
WEB_IMAGE=ghcr.io/adpediagitofficial/jemco-web:latest

# Email (SMTP). Leave SMTP_HOST empty to log instead of send.
MAIL_FROM=JEMCO NCR <ncr@jemco.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Attachments: empty = local volume; set for an S3-compatible bucket.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
