# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jemco
API_PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000
# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Mail (leave SMTP_HOST unset to log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="JEMCO NCR <ncr@jemco.example>"
# Attachments (leave S3_BUCKET unset to store on local disk under apps/api/uploads)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
# PDF rendering: path to a Chromium binary for playwright-core (unset on the Playwright base image)
CHROMIUM_PATH=
# Single sign-on (OpenID Connect). Leave OIDC_ISSUER unset to disable.
# Google Workspace: OIDC_ISSUER=https://accounts.google.com
# Microsoft 365:    OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/v1/auth/sso/callback
OIDC_LABEL=Google
OIDC_ALLOWED_DOMAINS=jemco.com.my
OIDC_AUTO_PROVISION=true
