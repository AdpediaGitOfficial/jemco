{
  "name": "jemco",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @jemco/api db:migrate",
    "db:seed": "pnpm --filter @jemco/api db:seed"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
